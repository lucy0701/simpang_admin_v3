# Supabase 프로젝트 설정값 — 이 파일을 .env.local 로 복사한 뒤 값을 채우세요.
# Supabase 대시보드 > Project Settings > API 에서 확인할 수 있습니다.
# .env* 는 .gitignore 에 걸려 있으므로 실제 키는 커밋되지 않습니다.

# Project URL
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# anon / publishable key — 브라우저에 노출되며 RLS 로 보호됩니다.
# (신규 프로젝트에서는 sb_publishable_... 형태의 publishable key 를 넣으면 됩니다)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role / secret key — RLS 를 우회합니다. 절대 클라이언트에 노출 금지.
# operator·role·admin_audit_log 등 정책 없는 어드민 테이블 접근에 필요합니다.
SUPABASE_SERVICE_ROLE_KEY=
